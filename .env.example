# MailGuard Environment Configuration Example
# Copy to .env and customize as needed. Never commit your real .env file!

# Splunk HTTP Event Collector (HEC) Configuration
SPLUNK_HEC_URL=http://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
SPLUNK_INDEX=security_lab
SPLUNK_VERIFY_SSL=false

# Optional OSINT / Threat Intelligence API Keys (Disabled by default)
# VT_API_KEY=your_virustotal_api_key_here
# URLSCAN_API_KEY=your_urlscan_api_key_here
# ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# MailGuard Web Interface Security
SECRET_KEY=change-this-to-a-random-32-byte-hex-string-for-session-csrf
MAILGUARD_PORT=5000
MAILGUARD_HOST=127.0.0.1
